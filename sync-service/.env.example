# Fabric network configuration
# Point these paths to your local fabric-samples/test-network crypto materials

CHANNEL_NAME=mychannel
CHAINCODE_NAME=digital-twin
MSP_ID=Org1MSP
PEER_ENDPOINT=localhost:7051
PEER_HOST_ALIAS=peer0.org1.example.com

# Example paths (replace /path/to/fabric-samples with your actual absolute path)
CRYPTO_PATH=/path/to/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
TLS_CERT_PATH=${CRYPTO_PATH}/peers/peer0.org1.example.com/tls/ca.crt
CERT_PATH=${CRYPTO_PATH}/users/User1@org1.example.com/msp/signcerts/User1@org1.example.com-cert.pem
KEY_PATH=${CRYPTO_PATH}/users/User1@org1.example.com/msp/keystore/
